{
  "name": "quotapie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "quotapie": "bun run src/cli.ts",
    "test": "bun test ./tests",
    "check": "bun run check:backend && bun run check:macos",
    "check:backend": "bun test ./tests && tsc --noEmit && bun build src/cli.ts --target=bun --outdir /tmp/quotapie-build",
    "check:macos": "bash script/test_codex_profiles.sh && bash script/build_and_run.sh --verify",
    "check:runtime": "bun script/check-runtime.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
